{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "lib": ["ES2023", "ES6", "DOM"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "."
  },

  "exclude": ["node_modules"],

  "include": ["src"]
}